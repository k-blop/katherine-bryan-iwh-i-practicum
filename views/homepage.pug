doctype html
html
  head
    title= title
    meta(name="viewport" content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="/css/style.css")
  body
    h1 Custom Object Directory
    a(href="/update-cobj") Add to this table
    
    table
      tr
        th Name
        th Bran Type
        th Info
      each record in records
        tr
          td #{record.properties.name}
          td #{record.properties.bean_type}
          td #{record.properties.info}